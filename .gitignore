# ---- temporary / intermediate files ----
# UTF-8 text extractions regenerated by local scripts
papers_txt/_tmp_utf8/

# ---- Python ----
__pycache__/
*.py[cod]

# ---- Office lock files ----
~$*.doc
~$*.docx
~$*.xls
~$*.xlsx
~$*.ppt
~$*.pptx

# ---- OS / editor junk ----
Thumbs.db
Desktop.ini
.DS_Store

# ---- 本地临时目录（中间结果，不提交）----
C题/_tmp/

# ---- 程序重跑在 C题/ 根目录生成的工作副本（提交版在 结果/ 与 附件/附件5/）----
C题/result*.xlsx
C题/q*_log.txt

# ---- LaTeX 编译中间产物（latexmk/xelatex 可重新生成，不提交）----
latex/**/*.aux
latex/**/*.log
latex/**/*.out
latex/**/*.fls
latex/**/*.fdb_latexmk
latex/**/*.synctex.gz
latex/**/*.xdv
latex/**/auto/

# ---- 求解程序绘图时生成的字体缓存哨兵（运行时自动重建，不提交）----
latex/**/_fonts_ready