# ---- 本地临时工作目录（复现验证期间生成，不提交）----
_bak_orig/
_run_logs/
优秀论文/papers_txt/_tmp_utf8/

# ---- Python ----
__pycache__/
*.py[cod]

# ---- Office 锁文件 ----
~$*.doc
~$*.docx
~$*.xls
~$*.xlsx
~$*.ppt
~$*.pptx

# ---- 系统 / 编辑器垃圾文件 ----
Thumbs.db
Desktop.ini
.DS_Store

# ---- LaTeX 编译中间产物（latexmk/xelatex 可重新生成，不提交）----
latex/**/*.aux
latex/**/*.log
latex/**/*.out
latex/**/*.fls
latex/**/*.fdb_latexmk
latex/**/*.synctex.gz
latex/**/*.xdv
latex/**/auto/

# 成品论文 latex/论文.pdf 需要提交，故不忽略 *.pdf

# xelatex 在本机偶发把成品 PDF 写成 GBK 误读的文件名（"论文"→"璁烘枃"），是同一成品的副本，可删
latex/*璁烘枃*.pdf

# ---- 求解程序绘图时生成的字体缓存哨兵（运行时自动重建，不提交）----
latex/**/_fonts_ready
